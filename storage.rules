rules_version = '2';

// Deploy via Firebase Console (Storage → Rules) or `firebase deploy --only storage`.
// Only authenticated users (incl. anonymous) can read/write under their trip,
// and uploads are limited to image files up to 8 MB.
service firebase.storage {
    match /b/{bucket}/o {
        match /trips/{tripId}/{allPaths=**} {
            allow read:  if request.auth != null
                         && tripId.matches('^[a-zA-Z0-9_-]{1,64}$');
            allow write: if request.auth != null
                         && tripId.matches('^[a-zA-Z0-9_-]{1,64}$')
                         && (request.resource == null
                             || (request.resource.size < 8 * 1024 * 1024
                                 && request.resource.contentType.matches('image/.*')));
        }
    }
}
